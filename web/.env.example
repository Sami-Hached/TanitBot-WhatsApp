# ===================================================================
# TanitBot API Gateway Environment Configuration
# ===================================================================

# 1. MODAL STREAMING PROXY TOKENS (Required for SSE streaming)
# Created via Modal CLI: modal workspace proxy-tokens create
# Or Modal Web Dashboard -> Settings -> Proxy Auth Tokens
# Note: These start with 'wk-' (ID) and 'ws-' (Secret)
MODAL_PROXY_TOKEN_ID=wk-xxxxxxxxx
MODAL_PROXY_TOKEN_SECRET=ws-xxxxxxxxx

# 2. MODAL WORKSPACE API TOKENS (Used by SDK to resolve endpoint URL & fallback)
# Created via Modal CLI: modal token new
# Or Modal Web Dashboard -> Settings -> API Tokens
# Note: These start with 'ak-' (ID) and 'as-' (Secret)
MODAL_TOKEN_ID=ak-xxxxxxxxx
MODAL_TOKEN_SECRET=as-xxxxxxxxx

# 3. DIRECT MODAL STREAM URL (Optional override)
# If you know the direct URL of the stream_http endpoint:
# MODAL_STREAM_URL=https://<workspace>--command-r-transformers-commandr-stream-http.modal.run

# 4. API PROTECTION KEY (Optional)
# If set, clients must pass this key via X-API-Key or Authorization: Bearer <key>
# CHAT_API_KEY=your-secret-chat-key
